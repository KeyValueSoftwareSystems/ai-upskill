# Copy to .env and fill in. Never commit .env.

# KeyValue's LiteLLM proxy. Every branch reads these two.
LITELLM_API_KEY=
LITELLM_BASE_URL=https://llm.keyvalue.systems/v1

# Chat model. A bare id runs through the proxy. provider:model (e.g. openai:gpt-5.4-mini, anthropic:claude-sonnet-5-5)
# with that provider's own key works too on the harness branches.
LAUNCHKIT_MODEL=gpt-4.1-mini

# Image model, through the same proxy.
LAUNCHKIT_IMAGE_MODEL=gpt-image-1

# Pictures. A real image takes about a minute through the proxy, so trainees keep placeholders on during the session.
# Comment the next line out to get real pictures. (LAUNCHKIT_IMAGE=fake means the same on the harness branches.)
LAUNCHKIT_IMAGES=placeholder

# Harness only: fakes for a keyless try. LAUNCHKIT_MODEL=fake:good | fake:echo | fake:malformed | fake:endless | fake:profile
