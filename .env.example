# Which model writes the copy and drives the picture tool. Form: provider:model_id.
# Any Agno provider works. Fakes for a keyless try: fake:good, fake:echo, fake:malformed, fake:endless.
LAUNCHKIT_MODEL=openai:gpt-5.4-mini
OPENAI_API_KEY=

# real = OpenAI image model (needs the key above). fake = a PNG drawn locally. Checks always use fake.
LAUNCHKIT_IMAGE=real
LAUNCHKIT_IMAGE_MODEL=gpt-image-2
LAUNCHKIT_IMAGE_SIZE=1024x1536
