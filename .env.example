# Copy to .env and fill in. Never commit .env.
LITELLM_API_KEY=                                  # the key KeyValue provides
LITELLM_BASE_URL=https://llm.keyvalue.systems/v1  # KeyValue's LiteLLM proxy
LAUNCHKIT_MODEL=gpt-4.1-mini                      # chat model for poster specs
LAUNCHKIT_IMAGE_PROVIDER=gpu                      # who makes pictures: gpu | litellm | placeholder (only that one is used)
LAUNCHKIT_IMAGE_MODEL=gpt-image-2                 # image model, used when LAUNCHKIT_IMAGE_PROVIDER=litellm (paid)
IMAGESVC_URL=http://192.168.1.50:8080/v1          # our GPU, over the VPN, used when LAUNCHKIT_IMAGE_PROVIDER=gpu
IMAGESVC_KEY=                                     # the GPU service key (ask the trainer)
