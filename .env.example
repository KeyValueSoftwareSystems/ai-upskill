# Copy to .env and fill in. Never commit .env.

# KeyValue's LiteLLM proxy. Every branch reads these two.
LITELLM_API_KEY=
LITELLM_BASE_URL=https://llm.keyvalue.systems/v1

# Chat model. A bare id runs through the proxy. openai:<model> with your own OPENAI_API_KEY goes direct.
LAUNCHKIT_MODEL=gpt-4.1-mini

# Image model, through the same proxy. Quality low | medium | high: medium comes back in about 30 seconds,
# high never comes back through the proxy for portrait sizes.
LAUNCHKIT_IMAGE_MODEL=gpt-image-1
LAUNCHKIT_IMAGE_QUALITY=medium

# Pictures come from our own GPU first, over the VPN (2 to 4 seconds each). If it can't be reached, the
# image model above takes over. Leave IMAGESVC_URL empty to go straight to the image model.
IMAGESVC_URL=http://192.168.1.50:8080/v1
IMAGESVC_KEY=

# Seconds one model or picture call may wait. The VPN tunnel restarts now and then and leaves a call hanging;
# a short wait lets the client's retry start on a fresh line.
LAUNCHKIT_TIMEOUT=120

# Pictures are real by default: 30 to 60 seconds each through the proxy. Uncomment the next line to draw a stand-in picture instead.
# LAUNCHKIT_IMAGES=placeholder

# Harness only: fakes for a keyless try. LAUNCHKIT_MODEL=fake:good | fake:echo | fake:malformed | fake:endless | fake:profile
