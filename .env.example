# Copy to .env and fill in. Never commit .env.

# KeyValue's LiteLLM proxy. Every branch reads these two.
LITELLM_API_KEY=
LITELLM_BASE_URL=https://llm.keyvalue.systems/v1

# Chat model. A bare id runs through the proxy. openai:<model> with your own OPENAI_API_KEY goes direct.
LAUNCHKIT_MODEL=gpt-4.1-mini

# Who makes the pictures. Only the one you pick is used; nothing switches over by itself.
#   gpu          our GPU, over the VPN: 2 to 4 seconds a picture (the default)
#   litellm      the image model below, through the proxy: 30 to 60 seconds a picture, paid
#   placeholder  a stand-in picture drawn by code, no call
LAUNCHKIT_IMAGE_PROVIDER=gpu

# Our GPU, used when LAUNCHKIT_IMAGE_PROVIDER=gpu.
IMAGESVC_URL=http://192.168.1.50:8080/v1
IMAGESVC_KEY=

# Image model, used when LAUNCHKIT_IMAGE_PROVIDER=litellm. Quality low | medium | high: medium comes back
# in about 30 seconds, high never comes back through the proxy for portrait sizes.
LAUNCHKIT_IMAGE_MODEL=gpt-image-2
LAUNCHKIT_IMAGE_QUALITY=medium

# Web search for search_web. web = the real web through Tavily (needs the key), saved = the saved pages in samples/.
LAUNCHKIT_SEARCH=web
TAVILY_API_KEY=

# Seconds one model or picture call may wait. The VPN tunnel restarts now and then and leaves a call hanging;
# a short wait lets the client's retry start on a fresh line.
LAUNCHKIT_TIMEOUT=120

# Harness only: fakes for a keyless try. LAUNCHKIT_MODEL=fake:good | fake:echo | fake:malformed | fake:endless | fake:profile
